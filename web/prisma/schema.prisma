datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

enum Role {
  ADMIN
  CHARGE_DAFFAIRE
  CLIENT
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model User {
  id                   String       @id @default(uuid())
  email                String       @unique
  password             String?
  fullName             String?
  role                 Role         @default(CLIENT)
  googleId             String?      @unique
  assignedSalesRepId   String?
  isActive             Boolean      @default(true)
  anonymizedAt         DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  assignedSalesRep     User?        @relation("SalesRepClients", fields: [assignedSalesRepId], references: [id], onDelete: SetNull)
  clients              User[]       @relation("SalesRepClients")
  tenants              Tenant[]
  subscriptions        Subscription[]
  invoices             Invoice[]
  quotesAsSalesRep     Quote[]      @relation("SalesRepQuotes")
  quotesAsClient       Quote[]      @relation("ClientQuotes")

  // Configuration Stripe & Paiements WoxxPay (Chargé d'affaires / Vendeur)
  stripeAccountId      String?
  stripePublishableKey String?
  stripeSecretKey      String?
  stripeWebhookSecret  String?
  stripeConnectStatus  String?      @default("NOT_CONNECTED") // NOT_CONNECTED, PENDING, CONNECTED, RESTRICTED
  bankIban             String?
  bankBic              String?
  bankAccountHolder    String?
  defaultCommissionRate Float?      @default(10.0)
  woxxpayLiveMode      Boolean      @default(false)

  // Identité & Coordonnées Commerciales (Logo, Agence, WhatsApp, Prise de RDV)
  avatarUrl            String?      // URL ou image en base64 du logo / photo
  companyName          String?      // Nom de l'agence ou raison sociale commerciale
  phoneNumber          String?      // Numéro de téléphone direct
  whatsappNumber       String?      // Numéro WhatsApp direct
  calendlyUrl          String?      // Lien de prise de RDV (Calendly / Meet / Cal.com)
  bio                  String?      // Message d'accueil / Bio pour les clients

  @@index([role])
  @@index([assignedSalesRepId])
}

model Tenant {
  id                      String       @id @default(uuid())
  userId                  String
  email                   String       @unique
  commerceName            String
  subdomain               String       @unique
  customDomain            String?
  status                  TenantStatus @default(PENDING)
  customCommissionPercent Float?
  modules                 String       @default("[]")
  tenantApiKey            String       @default(uuid())
  k8sNamespace            String?
  k8sStatus               String       @default("NOT_DEPLOYED")
  imageTag                String?      @default("ghcr.io/bezbee25/boutique-global:latest")
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  user                    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([subdomain])
}

model Subscription {
  id                 String       @id @default(uuid())
  userId             String
  woxxpayCustomerId  String?
  woxxpaySubId       String?
  billingCycle       String       @default("monthly")
  status             String       @default("active")
  currentPeriodEnd   DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices           Invoice[]

  @@index([userId])
  @@index([status])
}

model Invoice {
  id                 String       @id @default(uuid())
  invoiceNumber      String       @unique
  userId             String
  subscriptionId     String?
  totalHt            Float
  totalVat           Float
  totalTtc           Float
  vatRate            Float        @default(20.0)
  isVatExempt        Boolean      @default(false)
  legalNotice        String?
  pdfUrl             String?
  status             String       @default("PAID")
  createdAt          DateTime     @default(now())

  user               User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([invoiceNumber])
  @@index([createdAt])
}

model Coupon {
  id                 String       @id @default(uuid())
  code               String       @unique
  discountPercent    Float?
  discountAmount     Float?
  maxUses            Int?
  usesCount          Int          @default(0)
  expiresAt          DateTime?
  isActive           Boolean      @default(true)
  assignedSalesRepId String?
  targetUserId       String?
  createdAt          DateTime     @default(now())
}

model ModuleCatalog {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  description      String
  category         String   @default("general")
  priceMonthly     Float    @default(0.0)
  priceYearly      Float    @default(0.0)
  costPriceMonthly Float    @default(0.0)
  isActive         Boolean  @default(true)
  isCore           Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  PAID
  REJECTED
}

enum PaymentMethod {
  WOXXPAY_CARD
  WOXXPAY_TRANSFER
  MANUAL_TRANSFER
}

model Quote {
  id                String         @id @default(uuid())
  quoteNumber       String         @unique
  title             String
  description       String?
  salesRepId        String
  clientId          String
  tenantId          String?
  items             String         @default("[]")
  totalHt           Float
  totalVat          Float
  totalTtc          Float
  status            QuoteStatus    @default(DRAFT)
  paymentMethod     PaymentMethod?
  woxxpayPaymentId  String?
  woxxpayPaymentUrl String?
  bankDetails       String?
  
  // Répartition financière & Commission WoxxPay (20% plateforme / 80% Chargé d'affaires)
  platformCommissionRate   Float?         @default(20.0) // 20% de commission plateforme
  platformCommissionAmount Float?                        // Montant commission WoxxApp
  salesRepPayoutAmount     Float?                        // Net reversé au Chargé d'Affaires (80%)
  stripeTransferId         String?                       // ID du transfert Stripe Connect

  validUntil        DateTime?
  acceptedAt        DateTime?
  paidAt            DateTime?
  pdfUrl            String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  salesRep          User           @relation("SalesRepQuotes", fields: [salesRepId], references: [id], onDelete: Restrict)
  client            User           @relation("ClientQuotes", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([salesRepId])
  @@index([clientId])
  @@index([status])
  @@index([quoteNumber])
}

model SystemSettings {
  id                 String       @id @default(uuid())
  key                String       @unique
  value              String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}
